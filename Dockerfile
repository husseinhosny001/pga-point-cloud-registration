# ==============================================================================\n# PGA ICP Engine - Production-Grade Multi-Stage Dockerfile\n# ==============================================================================\n# This Dockerfile implements a best-practice multi-stage build strategy:\n# Stage 1 (Builder): Compiles the engine with full optimization flags\n# Stage 2 (Runtime): Minimal production image with only runtime dependencies\n# ==============================================================================\n\n# ==============================================================================\n# STAGE 1: Build Environment\n# ==============================================================================\nFROM ubuntu:24.04 AS builder\n\n# Prevent interactive prompts during package installation\nENV DEBIAN_FRONTEND=noninteractive \\\n    LANG=C.UTF-8 \\\n    LC_ALL=C.UTF-8\n\n# Install build dependencies with minimal footprint\nRUN apt-get update && apt-get install -y --no-install-recommends \\\n    build-essential \\\n    g++-13 \\\n    cmake \\\n    ninja-build \\\n    git \\\n    ca-certificates \\\n    libomp-dev \\\n    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*\n\n# Set GCC 13 as the default compiler (supports C++20 with all optimizations)\nENV CC=gcc-13 \\\n    CXX=g++-13 \\\n    CXXFLAGS=\"-std=c++20 -O3 -march=haswell -mavx2 -mfma -fopenmp -ffast-math -flto=auto\" \\\n    LDFLAGS=\"-fopenmp\"\n\n# Set workspace directory\nWORKDIR /build\n\n# Copy project files\nCOPY CMakeLists.txt ./\nCOPY include/ ./include/\nCOPY src/ ./src/\nCOPY tests/ ./tests/\n\n# Configure and build with maximum optimization\n# -DCMAKE_BUILD_TYPE=Release: Release build (O3 optimizations)\n# -G Ninja: Use Ninja for faster parallel builds\n# -j$(nproc): Use all available CPU cores\nRUN cmake -B build -G Ninja \\\n    -DCMAKE_BUILD_TYPE=Release \\\n    -DCMAKE_CXX_FLAGS=\"-O3 -march=haswell -mavx2 -mfma -fopenmp -ffast-math -flto=auto\" \\\n    -DCMAKE_C_FLAGS=\"-O3 -march=haswell -mavx2 -mfma -flto=auto\" \\\n    && cmake --build build --config Release -j$(nproc) --verbose\n\n# Optional: Run unit tests to verify correctness\nRUN ctest --test-dir build --output-on-failure || true\n\n# ==============================================================================\n# STAGE 2: Minimal Runtime Environment\n# ==============================================================================\nFROM ubuntu:24.04 AS runtime\n\n# Prevent interactive prompts\nENV DEBIAN_FRONTEND=noninteractive \\\n    LANG=C.UTF-8 \\\n    LC_ALL=C.UTF-8 \\\n    OMP_NUM_THREADS=4 \\\n    OMP_PROC_BIND=true \\\n    OMP_DYNAMIC=false\n\n# Install only runtime dependencies (no build tools)\nRUN apt-get update && apt-get install -y --no-install-recommends \\\n    libgomp1 \\\n    libstdc++6 \\\n    ca-certificates \\\n    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*\n\n# Create non-root user for security\nRUN useradd -m -u 10001 -s /bin/bash pga-user\n\n# Set workspace\nWORKDIR /app\n\n# Copy compiled binary and libraries from builder stage\nCOPY --from=builder /build/build/bin/pga_icp_demo /app/pga_icp_demo\nCOPY --from=builder /build/build/lib/libpga_icp_core.so* /app/\n\n# Set permissions\nRUN chown -R pga-user:pga-user /app && \\\n    chmod +x /app/pga_icp_demo && \\\n    chmod 755 /app/*.so*\n\n# Switch to non-root user\nUSER pga-user\n\n# Health check: verify binary works\nHEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \\\n    CMD /app/pga_icp_demo --help > /dev/null 2>&1 || exit 1\n\n# Default command\nENTRYPOINT [\"/app/pga_icp_demo\"]\nCMD [\"--help\"]\n\n# ==============================================================================\n# STAGE 3: Development Environment (Optional)\n# ==============================================================================\nFROM builder AS development\n\n# Add development tools\nRUN apt-get update && apt-get install -y --no-install-recommends \\\n    gdb \\\n    valgrind \\\n    clang-format \\\n    clang-tidy \\\n    bear \\\n    && rm -rf /var/lib/apt/lists/*\n\n# Keep all build artifacts and source code\nWORKDIR /build\n\nCMD [\"/bin/bash\"]"